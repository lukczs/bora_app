{
  "version": 8,
  "id": "bora-dark",
  "name": "Bora escuro (estilo Moovit)",
  "metadata": {"version": "1"},
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {"type": "vector", "url": "https://tiles.openfreemap.org/planet"}
  },
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#0f172a"}},

    {
      "id": "landuse_residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", "class", "residential", "suburb", "neighbourhood", "commercial", "retail"],
      "paint": {"fill-color": "#141d33"}
    },
    {
      "id": "landuse_school", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", "class", "school", "university", "college", "hospital"],
      "paint": {"fill-color": "#1b2540"}
    },
    {
      "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": {"fill-color": "#16303a", "fill-opacity": 0.85}
    },
    {
      "id": "landcover_green", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "farmland", "wetland"],
      "paint": {"fill-color": "#152836", "fill-opacity": 0.7}
    },
    {
      "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "filter": ["!=", "brunnel", "tunnel"],
      "paint": {"fill-color": "#0c2747"}
    },
    {
      "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "filter": ["!=", "brunnel", "tunnel"],
      "paint": {"line-color": "#0c2747", "line-width": {"base": 1.3, "stops": [[10, 0.5], [16, 3]]}}
    },
    {
      "id": "aeroway", "type": "fill", "source": "openmaptiles", "source-layer": "aeroway",
      "filter": ["==", "$type", "Polygon"],
      "paint": {"fill-color": "#1b2540"}
    },
    {
      "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 14,
      "paint": {"fill-color": "#1e2946", "fill-outline-color": "#26335a"}
    },

    {
      "id": "road_path", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 15,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "path", "pedestrian"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": "#222d4b", "line-width": {"base": 1.2, "stops": [[15, 1], [20, 4]]}}
    },
    {
      "id": "road_rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 12,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "rail", "transit"]],
      "paint": {"line-color": "#2c3a5c", "line-width": {"base": 1.3, "stops": [[12, 0.6], [18, 2.5]]}}
    },
    {
      "id": "road_minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 13,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "minor", "service", "track", "busway"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": "#283655", "line-width": {"base": 1.2, "stops": [[13, 0.5], [14, 1.4], [16, 4], [18, 8], [20, 14]]}}
    },
    {
      "id": "road_secondary_tertiary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 10,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "secondary", "tertiary"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": "#31416a", "line-width": {"base": 1.2, "stops": [[10, 0.5], [12, 1.2], [14, 3], [16, 6], [18, 11], [20, 18]]}}
    },
    {
      "id": "road_trunk_primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 7,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "trunk", "primary"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": "#3a4d7c", "line-width": {"base": 1.2, "stops": [[7, 0.5], [10, 1.2], [12, 2.2], [14, 4.5], [16, 8], [18, 14], [20, 22]]}}
    },
    {
      "id": "road_motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 6,
      "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "motorway"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": "#46598c", "line-width": {"base": 1.2, "stops": [[6, 0.6], [10, 1.6], [12, 3], [14, 5.5], [16, 9], [18, 16], [20, 26]]}}
    },

    {
      "id": "water_name", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name", "minzoom": 11,
      "filter": ["==", "$type", "Point"],
      "layout": {"text-field": "{name}", "text-font": ["sans-serif Italic"], "text-size": 12, "text-max-width": 6},
      "paint": {"text-color": "#5b7aa0", "text-halo-color": "#0c2747", "text-halo-width": 1}
    },
    {
      "id": "road_label_minor", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 15,
      "filter": ["in", "class", "minor", "service", "track", "path", "pedestrian"],
      "layout": {
        "symbol-placement": "line", "text-field": "{name}", "text-font": ["sans-serif"],
        "text-size": {"base": 1, "stops": [[15, 10.5], [18, 13]]}
      },
      "paint": {"text-color": "#a7b4c8", "text-halo-color": "#0f172a", "text-halo-width": 1.5}
    },
    {
      "id": "road_label_major", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 12,
      "filter": ["!in", "class", "minor", "service", "track", "path", "pedestrian", "rail", "transit"],
      "layout": {
        "symbol-placement": "line", "text-field": "{name}", "text-font": ["sans-serif-medium"],
        "text-size": {"base": 1, "stops": [[12, 10.5], [15, 12], [18, 14]]}
      },
      "paint": {"text-color": "#e2e8f0", "text-halo-color": "#0f172a", "text-halo-width": 1.6}
    },
    {
      "id": "place_quadra", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 13,
      "filter": ["in", "class", "neighbourhood", "quarter", "hamlet", "isolated_dwelling"],
      "layout": {
        "text-field": "{name}", "text-font": ["sans-serif-medium"], "text-max-width": 8,
        "text-size": {"base": 1.2, "stops": [[13, 10.5], [16, 13]]}, "text-letter-spacing": 0.04
      },
      "paint": {"text-color": "#94a3b8", "text-halo-color": "#0f172a", "text-halo-width": 1.5}
    },
    {
      "id": "place_suburb", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 11, "maxzoom": 16,
      "filter": ["in", "class", "suburb"],
      "layout": {
        "text-field": "{name}", "text-font": ["sans-serif-medium"], "text-max-width": 8, "text-transform": "uppercase",
        "text-size": {"base": 1.2, "stops": [[11, 10.5], [15, 13]]}, "text-letter-spacing": 0.08
      },
      "paint": {"text-color": "#8a9bb5", "text-halo-color": "#0f172a", "text-halo-width": 1.5}
    },
    {
      "id": "place_town", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 8, "maxzoom": 15,
      "filter": ["in", "class", "town", "village"],
      "layout": {
        "text-field": "{name}", "text-font": ["sans-serif-medium"], "text-max-width": 8,
        "text-size": {"base": 1.2, "stops": [[8, 11], [13, 15]]}
      },
      "paint": {"text-color": "#e2e8f0", "text-halo-color": "#0f172a", "text-halo-width": 1.8}
    },
    {
      "id": "place_city", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 5, "maxzoom": 14,
      "filter": ["==", "class", "city"],
      "layout": {
        "text-field": "{name}", "text-font": ["sans-serif-medium"], "text-max-width": 8,
        "text-size": {"base": 1.2, "stops": [[6, 13], [12, 19]]}
      },
      "paint": {"text-color": "#ffffff", "text-halo-color": "#0f172a", "text-halo-width": 2}
    }
  ]
}
